{
  "name": "@atomic-oasis/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Atomic Oasis design system — Web Components",
  "license": "MIT",
  "files": ["dist", "src/tokens", "assets"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/style.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./theme": {
      "import": "./dist/theme.js",
      "types": "./dist/theme.d.ts"
    }
