  },
  "devDependencies": {
    "lit": "^3.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.0"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  }
